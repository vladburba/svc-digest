# Ключ OpenRouter — отбор новостей и выжимки.
# Получить: https://openrouter.ai → Keys
OPENROUTER_API_KEY=

# Токен Telegram-бота, от имени которого приходит дайджест — у @BotFather.
# Сейчас общий с vladburba-bot (техдолг: развязать).
BOT_TOKEN=

# Куда слать дайджест — числовой ID чата получателя.
ADMIN_CHAT_ID=

# Прокси для ВСЕГО исходящего трафика.
# Локально на маке — оставить пустым (всё доступно напрямую).
# На сервере — socks5://127.0.0.1:1080 (Xray), требует network_mode: host.
EGRESS_PROXY=
